---
// Декоративная координатная сетка. Географическая точность не заявляется.
---
<div class="hero-art" aria-hidden="true">
  <svg viewBox="0 0 400 400" focusable="false">
    <circle class="g-line draw" pathLength="1" cx="200" cy="200" r="180" />
    <ellipse class="g-line draw" pathLength="1" cx="200" cy="200" rx="135" ry="180" />
    <ellipse class="g-line draw" pathLength="1" cx="200" cy="200" rx="90" ry="180" />
    <ellipse class="g-line draw" pathLength="1" cx="200" cy="200" rx="45" ry="180" />
    <line class="g-line draw" pathLength="1" x1="200" y1="20" x2="200" y2="380" />
    <line class="g-line draw" pathLength="1" x1="20" y1="200" x2="380" y2="200" />
    <line class="g-line draw" pathLength="1" x1="65.8" y1="80" x2="334.2" y2="80" />
    <line class="g-line draw" pathLength="1" x1="65.8" y1="320" x2="334.2" y2="320" />
    <line class="g-line draw" pathLength="1" x1="30.3" y1="140" x2="369.7" y2="140" />
    <line class="g-line draw" pathLength="1" x1="30.3" y1="260" x2="369.7" y2="260" />
    <polyline class="g-accent draw" pathLength="1" points="130,150 215,120 265,215 190,270" stroke-dasharray="1" />
    <g class="pop" style="--d:1.4s">
      <circle class="g-dot" cx="130" cy="150" r="3.5" />
      <circle class="g-dot" cx="215" cy="120" r="3.5" />
      <circle class="g-dot" cx="190" cy="270" r="3.5" />
      <circle class="g-dot" cx="265" cy="215" r="3.5" />
      <circle class="g-dot-ring" cx="265" cy="215" r="11" />
      <text x="281" y="209">A</text>
    </g>
  </svg>
</div>
