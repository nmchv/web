---
import { content } from '../data';
const { ui, profile, contacts } = content;
const START = 2026;
const y = new Date().getFullYear();
const years = y > START ? `${START}–${y}` : `${START}`;
const github = contacts.find((c) => c.id === 'github');
---
<footer class="site-footer">
  <div class="container">
    <p>© {years} {ui.footer.rights}</p>
    <nav class="footer-nav" aria-label="Навигация в подвале">
      <a href="#top">{ui.footer.toTop}</a>
      <a href="#projects">{ui.nav.projects}</a>
      <a href="#about">{ui.nav.about}</a>
      {contacts.length > 0 && <a href="#contacts">{ui.nav.contacts}</a>}
      {github && <a href={github.href} target="_blank" rel="noopener noreferrer">GitHub</a>}
    </nav>
  </div>
</footer>
