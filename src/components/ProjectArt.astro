---
// Графика карточек проектов. Чистый SVG, без внешних файлов и без привязки к реальным данным.
import type { ProjectArt } from '../i18n/types';
interface Props { kind: ProjectArt }
const { kind } = Astro.props;
const border = 'var(--color-border)';
const accent = 'var(--color-accent)';
const rows = [44, 80, 116, 152, 188];
const cols = [140, 220, 300, 380];
---
<svg viewBox="0 0 480 220" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {kind === 'diary' && (
    <g class="art" fill="none" stroke={border} stroke-width="1">
      <rect x="40" y="20" width="400" height="180" />
      <line x1="40" y1="44" x2="440" y2="44" stroke="var(--color-text-secondary)" stroke-opacity=".5" />
      {rows.slice(1).map((y) => <line x1="40" y1={y} x2="440" y2={y} />)}
      {cols.map((x) => <line x1={x} y1="20" x2={x} y2="200" />)}
      <rect x="148" y="88" width="64" height="20" fill={accent} fill-opacity=".85" stroke="none" />
      <rect x="228" y="124" width="64" height="20" fill={accent} fill-opacity=".45" stroke="none" />
      <rect x="308" y="52" width="64" height="20" fill={accent} fill-opacity=".25" stroke="none" />
      <rect x="388" y="160" width="44" height="20" fill={accent} fill-opacity=".6" stroke="none" />
      {[0, 1, 2, 3, 4].map((i) => (
        <line x1="52" y1={32 + i * 36 + (i ? 12 : 0)} x2={86 + (i % 3) * 14} y2={32 + i * 36 + (i ? 12 : 0)} stroke="var(--color-text-secondary)" stroke-opacity=".7" stroke-width="2" />
      ))}
    </g>
  )}

  {kind === 'geo' && (
    <g class="art" fill="none" stroke={border} stroke-width="1">
      {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => <line x1={i * 60} y1="0" x2={i * 60} y2="220" />)}
      {[0, 1, 2, 3, 4].map((i) => <line x1="0" y1={i * 55} x2="480" y2={i * 55} />)}
      <path d="M40 150 C 90 90, 130 120, 180 80 S 270 40, 310 90 S 390 150, 450 110" stroke="var(--color-text-secondary)" stroke-opacity=".6" />
      <path d="M60 190 C 120 150, 170 175, 230 150 S 330 170, 420 150" stroke="var(--color-text-secondary)" stroke-opacity=".3" />
      <polyline points="120,112 215,70 305,95 372,128" stroke={accent} stroke-width="1.25" stroke-dasharray="4 5" />
      {[[120,112],[215,70],[305,95],[372,128]].map(([x,y], i) => (
        <g>
          <circle cx={x} cy={y} r="4" fill={accent} stroke="none" />
          {i === 1 && <circle cx={x} cy={y} r="11" stroke="var(--color-accent-hover)" />}
        </g>
      ))}
      <path d="M215 52 V 88 M197 70 H 233" stroke="var(--color-accent-hover)" stroke-opacity=".6" />
    </g>
  )}

  {kind === 'notes' && (
    <g class="art" fill="none" stroke={border} stroke-width="1">
      <rect x="150" y="34" width="210" height="160" fill="var(--color-surface)" transform="rotate(-6 255 114)" />
      <rect x="130" y="26" width="210" height="160" fill="var(--color-surface-elevated)" transform="rotate(-2 235 106)" />
      <g stroke="none">
        <rect x="150" y="46" width="90" height="10" fill={accent} />
        <rect x="150" y="68" width="160" height="3" fill="var(--color-text-secondary)" fill-opacity=".6" />
        <rect x="150" y="80" width="140" height="3" fill="var(--color-text-secondary)" fill-opacity=".6" />
        <rect x="150" y="92" width="150" height="3" fill="var(--color-text-secondary)" fill-opacity=".6" />
        <rect x="150" y="112" width="60" height="6" fill="var(--color-text-secondary)" fill-opacity=".8" />
        <rect x="150" y="128" width="160" height="3" fill="var(--color-text-secondary)" fill-opacity=".35" />
        <rect x="150" y="140" width="120" height="3" fill="var(--color-text-secondary)" fill-opacity=".35" />
        <rect x="150" y="152" width="140" height="3" fill="var(--color-text-secondary)" fill-opacity=".35" />
      </g>
      <rect x="130" y="26" width="210" height="160" stroke="var(--color-text-secondary)" stroke-opacity=".5" transform="rotate(-2 235 106)" />
    </g>
  )}
</svg>
