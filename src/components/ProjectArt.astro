---
// Графика карточек проектов. Чистый SVG, без внешних файлов и без привязки к реальным данным.
import type { ProjectArt } from '../i18n/types';
interface Props { kind: ProjectArt }
const { kind } = Astro.props;
const border = 'var(--color-border)';
const accent = 'var(--color-accent)';
const rows = [44, 80, 116, 152, 188];
const cols = [140, 220, 300, 380];
---
<svg viewBox="0 0 480 220" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  {kind === 'diary' && (
    <g class="art" fill="none" stroke={border} stroke-width="1">
      <rect x="40" y="20" width="400" height="180" />
      <line x1="40" y1="44" x2="440" y2="44" stroke="var(--color-text-secondary)" stroke-opacity=".5" />
      {rows.slice(1).map((y) => <line x1="40" y1={y} x2="440" y2={y} />)}
      {cols.map((x) => <line x1={x} y1="20" x2={x} y2="200" />)}
      <rect class="schedule-event" style="--i:0" x="148" y="88" width="64" height="20" fill={accent} fill-opacity=".85" stroke="none" />
      <rect class="schedule-event" style="--i:1" x="228" y="124" width="64" height="20" fill={accent} fill-opacity=".45" stroke="none" />
      <rect class="schedule-event" style="--i:2" x="308" y="52" width="64" height="20" fill={accent} fill-opacity=".25" stroke="none" />
      <rect class="schedule-event" style="--i:3" x="388" y="160" width="44" height="20" fill={accent} fill-opacity=".6" stroke="none" />
      {[0, 1, 2, 3, 4].map((i) => (
        <line x1="52" y1={32 + i * 36 + (i ? 12 : 0)} x2={86 + (i % 3) * 14} y2={32 + i * 36 + (i ? 12 : 0)} stroke="var(--color-text-secondary)" stroke-opacity=".7" stroke-width="2" />
      ))}
    </g>
  )}

  {kind === 'geo' && (
    <g class="art" fill="none" stroke={border} stroke-width="1">
      {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => <line x1={i * 60} y1="0" x2={i * 60} y2="220" />)}
      {[0, 1, 2, 3, 4].map((i) => <line x1="0" y1={i * 55} x2="480" y2={i * 55} />)}
      <path d="M40 150 C 90 90, 130 120, 180 80 S 270 40, 310 90 S 390 150, 450 110" stroke="var(--color-text-secondary)" stroke-opacity=".6" />
      <path d="M60 190 C 120 150, 170 175, 230 150 S 330 170, 420 150" stroke="var(--color-text-secondary)" stroke-opacity=".3" />
      <polyline class="geo-route" pathLength="1" points="120,112 215,70 305,95 372,128" stroke={accent} stroke-width="1.25" stroke-dasharray="4 5" />
      {[[120,112],[215,70],[305,95],[372,128]].map(([x,y], i) => (
        <g>
          <circle cx={x} cy={y} r="4" fill={accent} stroke="none" />
          {i === 1 && <circle class="geo-marker" cx={x} cy={y} r="11" stroke="var(--color-accent-hover)" />}
        </g>
      ))}
      <path d="M215 52 V 88 M197 70 H 233" stroke="var(--color-accent-hover)" stroke-opacity=".6" />
    </g>
  )}

  {kind === 'notes' && (
    <g class="art" fill="none" stroke={border} stroke-width="1">
      <rect x="150" y="34" width="210" height="160" fill="var(--color-surface)" transform="rotate(-6 255 114)" />
      <rect x="130" y="26" width="210" height="160" fill="var(--color-surface-elevated)" transform="rotate(-2 235 106)" />
      <g class="notes-ink" stroke="none">
        <rect x="150" y="46" width="90" height="10" fill={accent} />
        <rect x="150" y="68" width="160" height="3" fill="var(--color-text-secondary)" fill-opacity=".6" />
        <rect x="150" y="80" width="140" height="3" fill="var(--color-text-secondary)" fill-opacity=".6" />
        <rect x="150" y="92" width="150" height="3" fill="var(--color-text-secondary)" fill-opacity=".6" />
        <rect x="150" y="112" width="60" height="6" fill="var(--color-text-secondary)" fill-opacity=".8" />
        <rect x="150" y="128" width="160" height="3" fill="var(--color-text-secondary)" fill-opacity=".35" />
        <rect x="150" y="140" width="120" height="3" fill="var(--color-text-secondary)" fill-opacity=".35" />
        <rect x="150" y="152" width="140" height="3" fill="var(--color-text-secondary)" fill-opacity=".35" />
      </g>
      <rect x="130" y="26" width="210" height="160" stroke="var(--color-text-secondary)" stroke-opacity=".5" transform="rotate(-2 235 106)" />
    </g>
  )}

  {kind === 'test' && (
    <g class="art" fill="none" stroke={border} stroke-width="1">
      <rect x="150" y="22" width="180" height="176" rx="8" fill="var(--color-surface-elevated)" />
      <path d="M205 22v-5a8 8 0 0 1 8-8h54a8 8 0 0 1 8 8v5" stroke="var(--color-text-secondary)" />
      <rect x="174" y="47" width="72" height="7" rx="3.5" fill={accent} stroke="none" />
      <rect x="174" y="62" width="122" height="3" rx="1.5" fill="var(--color-text-secondary)" stroke="none" opacity=".55" />
      <rect x="174" y="82" width="58" height="5" rx="2.5" fill="var(--color-text-secondary)" stroke="none" opacity=".8" />
      <rect x="174" y="94" width="116" height="3" rx="1.5" fill="var(--color-text-secondary)" stroke="none" opacity=".35" />
      <circle cx="183" cy="117" r="6" />
      <circle cx="183" cy="117" r="3" fill={accent} stroke="none" />
      <rect x="198" y="115" width="82" height="3" rx="1.5" fill="var(--color-text-secondary)" stroke="none" opacity=".55" />
      <circle cx="183" cy="139" r="6" />
      <rect x="198" y="137" width="68" height="3" rx="1.5" fill="var(--color-text-secondary)" stroke="none" opacity=".55" />
      <circle cx="183" cy="161" r="6" />
      <rect x="198" y="159" width="92" height="3" rx="1.5" fill="var(--color-text-secondary)" stroke="none" opacity=".55" />
      <circle cx="322" cy="148" r="28" fill="var(--color-surface)" stroke={accent} stroke-width="2" />
      <path class="test-check" pathLength="1" d="m309 148 12 12 23-27" stroke={accent} stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}

  {kind === 'graph' && (
    <g class="art project-art-graph" fill="none" stroke={border} stroke-width="1.5">
      <path d="M118 110 212 54l104 42 70-26M118 110l47 70 151-84 39 77M212 54l13 126M316 96l31-76M165 180l-63 17" stroke="var(--color-text-secondary)" stroke-opacity=".48" />
      <path class="graph-link" pathLength="1" d="m118 110 94-56 104 42-151 84z" stroke={accent} stroke-opacity=".65" />
      {[[118,110,10],[212,54,13],[316,96,16],[165,180,9],[347,20,8],[386,170,10],[102,197,7],[225,180,8]].map(([x,y,r], i) => (
        <g class="graph-node" style={`--i:${i}`}>
          <circle cx={x} cy={y} r={r} fill="var(--color-surface)" stroke={i < 4 ? accent : border} />
          {i === 2 && <circle cx={x} cy={y} r="4" fill={accent} stroke="none" />}
        </g>
      ))}
    </g>
  )}

  {kind === 'world-map' && (
    <g class="art project-art-world" fill="none" stroke={border} stroke-width="1">
      <path d="M58 77 86 54l29 5 16-13 20 8 9 20-13 13 7 15-20 15-7 26-22 5-8-24-18-7-14-18zM188 71l21-19 27 4 18 15 25 2 9 19-13 15-20-4-12 18-21-6-17 14-13-16-19-5 4-19-13-7zM262 132l24-13 32 6 13 19-10 26-22 18-19-9-8-24-17-9zM354 73l20-8 18 11-8 17-22 1-13-10z" fill="var(--color-surface-elevated)" stroke-opacity=".85" />
      <path class="world-route" pathLength="1" d="M102 81 Q191 18 287 94T372 83" stroke={accent} stroke-dasharray="5 6" />
      {[[102,81],[203,57],[287,94],[372,83],[300,153]].map(([x,y], i) => (
        <g class="world-pin" style={`--i:${i}`}>
          <circle cx={x} cy={y} r="8" fill={accent} fill-opacity=".12" stroke={accent} />
          <circle cx={x} cy={y} r="2.5" fill={accent} stroke="none" />
        </g>
      ))}
    </g>
  )}

  {kind === 'forms' && (
    <g class="art project-art-forms" fill="none" stroke={border} stroke-width="1">
      <rect x="126" y="22" width="228" height="176" rx="8" fill="var(--color-surface-elevated)" />
      <path d="M126 48h228" stroke="var(--color-text-secondary)" stroke-opacity=".4" />
      <circle cx="143" cy="35" r="3" fill={accent} stroke="none" />
      <rect x="151" y="63" width="122" height="8" rx="4" fill={accent} fill-opacity=".8" stroke="none" />
      <rect x="151" y="81" width="165" height="4" rx="2" fill="var(--color-text-secondary)" fill-opacity=".55" stroke="none" />
      <rect x="151" y="97" width="174" height="28" rx="4" fill="var(--color-background)" />
      <rect class="form-check" x="151" y="137" width="12" height="12" rx="3" stroke={accent} />
      <path class="form-tick" d="m154 143 3 3 6-7" stroke={accent} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <rect x="172" y="141" width="92" height="4" rx="2" fill="var(--color-text-secondary)" fill-opacity=".6" stroke="none" />
      <rect x="151" y="162" width="73" height="20" rx="4" fill={accent} fill-opacity=".78" stroke="none" />
      <path d="M170 170h35" stroke="var(--color-background)" stroke-opacity=".8" />
      <circle class="form-cursor" cx="318" cy="132" r="11" fill={accent} fill-opacity=".18" stroke={accent} />
    </g>
  )}

  {kind === 'exam' && (
    <g class="art project-art-exam" fill="none" stroke={border} stroke-width="1">
      <rect x="132" y="24" width="218" height="172" rx="8" fill="var(--color-surface-elevated)" />
      <rect x="156" y="45" width="88" height="7" rx="3.5" fill={accent} stroke="none" />
      <rect x="156" y="60" width="144" height="4" rx="2" fill="var(--color-text-secondary)" fill-opacity=".45" stroke="none" />
      {[0,1,2].map((i) => (
        <g class="exam-answer" style={`--i:${i}`}>
          <rect x="156" y={82 + i * 25} width="166" height="18" rx="4" fill="var(--color-background)" />
          <circle cx="171" cy={91 + i * 25} r="4.5" stroke={i === 1 ? accent : 'var(--color-text-secondary)'} />
          {i === 1 && <circle cx="171" cy={91 + i * 25} r="2.5" fill={accent} stroke="none" />}
          <rect x="185" y={89 + i * 25} width={76 + i * 13} height="4" rx="2" fill="var(--color-text-secondary)" fill-opacity=".6" stroke="none" />
        </g>
      ))}
      <circle class="exam-progress" cx="323" cy="168" r="16" stroke={accent} stroke-width="3" stroke-dasharray="76 24" transform="rotate(-90 323 168)" />
      <path d="m317 168 4 4 8-9" stroke={accent} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}
</svg>
