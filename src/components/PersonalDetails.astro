  ko: { 1: '마법사', 3: '여황제', 5: '교황', 6: '연인', 7: '전차', 8: '정의', 9: '은둔자', 10: '운명의 수레바퀴', 11: '힘', 12: '매달린 사람', 13: '변화', 15: '악마', 16: '탑', 19: '태양', 21: '세계', 22: '광대' },
  zh: { 1: '魔术师', 3: '皇后', 5: '教皇', 6: '恋人', 7: '战车', 8: '正义', 9: '隐者', 10: '命运之轮', 11: '力量', 12: '倒吊人', 13: '转变', 15: '恶魔', 16: '高塔', 19: '太阳', 21: '世界', 22: '愚者' },
  ja: { 1: '魔術師', 3: '女帝', 5: '教皇', 6: '恋人', 7: '戦車', 8: '正義', 9: '隠者', 10: '運命の輪', 11: '力', 12: '吊るされた男', 13: '変容', 15: '悪魔', 16: '塔', 19: '太陽', 21: '世界', 22: '愚者' },
  de: { 1: 'Der Magier', 3: 'Die Herrscherin', 5: 'Der Hierophant', 6: 'Die Liebenden', 7: 'Der Wagen', 8: 'Die Gerechtigkeit', 9: 'Der Eremit', 10: 'Das Rad des Schicksals', 11: 'Die Kraft', 12: 'Der Gehängte', 13: 'Wandlung', 15: 'Der Teufel', 16: 'Der Turm', 19: 'Die Sonne', 21: 'Die Welt', 22: 'Der Narr' },
  sv: { 1: 'Magikern', 3: 'Kejsarinnan', 5: 'Hierofanten', 6: 'De älskande', 7: 'Vagnen', 8: 'Rättvisan', 9: 'Eremiten', 10: 'Lyckohjulet', 11: 'Styrkan', 12: 'Den hängde', 13: 'Förvandling', 15: 'Djävulen', 16: 'Tornet', 19: 'Solen', 21: 'Världen', 22: 'Narren' },
};
const names = arcanaNames[lang] ?? arcanaNames.en;
const arcanaTitle = (value: number) => names[value] ?? `${value} · ${lang === 'ru' ? 'аркан' : 'Arcana'}`;
type PointRole = 'primary' | 'derived' | 'supporting' | 'center';
const points: Array<{ id: string; value: number; title: string; role: PointRole; x: number; y: number; detail: string }> = [
  { id: 'day', value: day, title: arcanaTitle(day), role: 'primary', x: 15, y: 50, detail: `${copy.birthday}: ${formattedBirthday}.` },
  { id: 'month', value: month, title: arcanaTitle(month), role: 'primary', x: 50, y: 9, detail: `${copy.birthday}: ${formattedBirthday}.` },
  { id: 'year', value: year, title: arcanaTitle(year), role: 'primary', x: 85, y: 50, detail: `${copy.birthday}: ${formattedBirthday}.` },
  { id: 'base', value: base, title: arcanaTitle(base), role: 'primary', x: 50, y: 91, detail: `10 + 3 + 6 → ${base}.` },
  { id: 'day-month', value: reduceArcana(day + month), title: arcanaTitle(reduceArcana(day + month)), role: 'derived', x: 32.5, y: 29.5, detail: `10 + 3 → ${reduceArcana(day + month)}.` },
  { id: 'month-year', value: reduceArcana(month + year), title: arcanaTitle(reduceArcana(month + year)), role: 'derived', x: 67.5, y: 29.5, detail: `3 + 6 → ${reduceArcana(month + year)}.` },
  { id: 'year-base', value: reduceArcana(year + base), title: arcanaTitle(reduceArcana(year + base)), role: 'derived', x: 67.5, y: 70.5, detail: `6 + 19 → ${reduceArcana(year + base)}.` },
  { id: 'base-day', value: reduceArcana(base + day), title: arcanaTitle(reduceArcana(base + day)), role: 'derived', x: 32.5, y: 70.5, detail: `19 + 10 → ${reduceArcana(base + day)}.` },
  { id: 'center', value: center, title: arcanaTitle(center), role: 'center', x: 50, y: 50, detail: copy.centerNote },
  { id: 'day-inner', value: reduceArcana(day + reduceArcana(day + month)), title: arcanaTitle(reduceArcana(day + reduceArcana(day + month))), role: 'supporting', x: 23.75, y: 15, detail: `10 + 13 → ${reduceArcana(day + reduceArcana(day + month))}.` },
  { id: 'month-inner', value: reduceArcana(month + reduceArcana(day + month)), title: arcanaTitle(reduceArcana(month + reduceArcana(day + month))), role: 'supporting', x: 41.25, y: 15, detail: `3 + 13 → ${reduceArcana(month + reduceArcana(day + month))}.` },
  { id: 'month-inner-right', value: reduceArcana(month + reduceArcana(month + year)), title: arcanaTitle(reduceArcana(month + reduceArcana(month + year))), role: 'supporting', x: 58.75, y: 15, detail: `3 + 9 → ${reduceArcana(month + reduceArcana(month + year))}.` },
  { id: 'year-inner', value: reduceArcana(year + reduceArcana(month + year)), title: arcanaTitle(reduceArcana(year + reduceArcana(month + year))), role: 'supporting', x: 76.25, y: 15, detail: `6 + 9 → ${reduceArcana(year + reduceArcana(month + year))}.` },
  { id: 'year-inner-bottom', value: reduceArcana(year + reduceArcana(year + base)), title: arcanaTitle(reduceArcana(year + reduceArcana(year + base))), role: 'supporting', x: 76.25, y: 85, detail: `6 + 3 → ${reduceArcana(year + reduceArcana(year + base))}.` },
  { id: 'base-inner-right', value: reduceArcana(base + reduceArcana(year + base)), title: arcanaTitle(reduceArcana(base + reduceArcana(year + base))), role: 'supporting', x: 58.75, y: 85, detail: `19 + 7 → ${reduceArcana(base + reduceArcana(year + base))}.` },
  { id: 'base-inner-left', value: reduceArcana(base + reduceArcana(base + day)), title: arcanaTitle(reduceArcana(base + reduceArcana(base + day))), role: 'supporting', x: 41.25, y: 85, detail: `19 + 11 → ${reduceArcana(base + reduceArcana(base + day))}.` },
  { id: 'day-inner-bottom', value: reduceArcana(day + reduceArcana(base + day)), title: arcanaTitle(reduceArcana(day + reduceArcana(base + day))), role: 'supporting', x: 23.75, y: 85, detail: `10 + 11 → ${reduceArcana(day + reduceArcana(base + day))}.` },
];
const roleLabels: Record<PointRole, string> = {
  primary: copy.primary,
  derived: copy.derived,
  supporting: copy.supporting,
  center: copy.center,
};
---

<section class:list={['personal-details', bloodFirst && 'personal-details--blood-first']} aria-labelledby="personal-details-heading">
  <h2 id="personal-details-heading">{copy.heading}</h2>
  <p class="personal-intro">{copy.intro}</p>

  <div class="personal-grid">
    <details class="personal-card birth-card">
      <summary>
        <span class="card-kicker">{copy.birthday}</span>
        <time class="birth-date" datetime="2004-03-28">{formattedBirthday}</time>
        <span class="card-action">{copy.open}<span aria-hidden="true">↗</span></span>
      </summary>
      <div class="card-detail"><p>{copy.birthday}: <time datetime="2004-03-28">{formattedBirthday}</time>. {copy.natalDetail}</p></div>
    </details>

    <details class="personal-card blood-card">
      <summary>
        <span class="card-kicker">{copy.blood}</span>
        <span class="blood-visual" aria-hidden="true"><span>A</span><i>II</i><b>Rh+</b><svg viewBox="0 0 160 100"><path d="M80 8 142 42v18l-62 34L18 60V42zM18 42l62 36 62-36M80 78v16" /></svg></span>
        <span class="card-title">{copy.bloodType}</span>
        <span class="card-action">{copy.open}<span aria-hidden="true">↗</span></span>
      </summary>
      <div class="card-detail"><p>{copy.bloodDetail}</p></div>
    </details>

    <details class="personal-card personality-card">
      <summary>
        <span class="card-kicker">{copy.type}</span>
        <span class="personality-visual" aria-hidden="true">
          <span class="personality-monogram">INTJ</span>
          <svg viewBox="0 0 240 140">
            <path class="personality-axis" d="M24 110h192M45 91 93 57l40 16 65-50" />
            <path class="personality-path" d="M45 91 93 57l40 16 65-50" />
            <circle class="personality-node" cx="45" cy="91" r="6" />
            <circle class="personality-node" cx="93" cy="57" r="6" />
            <circle class="personality-node" cx="133" cy="73" r="6" />
            <circle class="personality-node personality-node--last" cx="198" cy="23" r="8" />
            <path class="personality-bracket" d="M45 100v7h153v-7" />
          </svg>
          <span class="personality-name">{copy.strategist}</span>
        </span>
        <span class="card-action">{copy.open}<span aria-hidden="true">↗</span></span>
      </summary>
      <div class="card-detail"><p>{copy.typeDetail}</p></div>
    </details>

    <section class="personal-card matrix-card" aria-labelledby="matrix-title">
      <div class="card-kicker">{copy.matrixKicker}</div>
      <h3 id="matrix-title">{copy.matrix}</h3>
      <p class="card-subtitle">{copy.matrixHint}</p>
      <div class="matrix-canvas" role="group" aria-label={copy.matrix}>
        <svg class="matrix-lines" viewBox="0 0 100 100" aria-hidden="true">
          <path class="matrix-diamond" d="M50 9 85 50 50 91 15 50 50 9" />
          <path class="matrix-cross" d="M50 9v82M15 50h70M32.5 29.5 67.5 70.5M67.5 29.5 32.5 70.5" />
          <path class="matrix-inner" d="M23.75 15 76.25 15 85 50 76.25 85 23.75 85 15 50Z" />
          <circle cx="50" cy="50" r="23" />
        </svg>
        {points.map((point, index) => (
          <button
            class:list={['matrix-point', `matrix-point--${point.role}`, index === 0 && 'is-selected']}
            type="button"
            style={`--point-x:${point.x}%;--point-y:${point.y}%`}
            data-arcana-id={point.id}
            data-arcana-title={point.title}
            data-arcana-note={point.detail}
            data-arcana-value={point.value}
            aria-label={`${roleLabels[point.role]} ${point.value}: ${point.title}`}
            aria-pressed={index === 0 ? 'true' : 'false'}
            title={`${point.value} · ${point.title}`}
          >
            <span>{point.value}</span>
          </button>
        ))}
      </div>
      <div class="matrix-legend" aria-label={copy.matrix}>
        <span class="legend-primary">{copy.primary}</span>
        <span class="legend-derived">{copy.derived}</span>
        <span class="legend-supporting">{copy.supporting}</span>
      </div>
      <div class="matrix-reading" aria-live="polite" aria-atomic="true">
        <span class="reading-label">{copy.selected}</span>
        <strong class="reading-title">{arcanaTitle(day)}</strong>
        <p class="reading-note">{copy.birthday}: {formattedBirthday}.</p>
      </div>
      <p class="matrix-footnote">{copy.formula}</p>
    </section>

    <details class="personal-card natal-card">
      <summary>
        <span class="card-kicker">{copy.astrology}</span>
        <span class="natal-visual" aria-hidden="true">
          <svg viewBox="0 0 220 170">
            <circle class="natal-orbit" cx="110" cy="84" r="56" />
            <circle class="natal-orbit natal-orbit--inner" cx="110" cy="84" r="35" />
            <path class="natal-cross" d="M110 22v124M48 84h124M66 40l88 88M154 40l-88 88" />
            <circle class="natal-star" cx="110" cy="28" r="4" />
            <circle class="natal-star" cx="160" cy="105" r="3" />
            <circle class="natal-star" cx="72" cy="116" r="3" />
          </svg>
          <span>✳</span>
        </span>
        <span class="card-title">{copy.natal}</span>
        <span class="card-status">{copy.inProgress}</span>
        <span class="card-action">{copy.open}<span aria-hidden="true">↗</span></span>
      </summary>
      <div class="card-detail"><p>{copy.natalDetail}</p></div>
    </details>
  </div>

  <p class="personal-disclaimer">{copy.disclaimer}</p>
</section>

<script>
  const matrixButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.matrix-point'));
  const matrixReading = document.querySelector<HTMLElement>('.matrix-reading');
  const readingTitle = matrixReading?.querySelector<HTMLElement>('.reading-title');
  const readingNote = matrixReading?.querySelector<HTMLElement>('.reading-note');

  for (const button of matrixButtons) {
    const showReading = () => {
      const title = button.dataset.arcanaTitle;
      const note = button.dataset.arcanaNote;
      if (!title || !note || !readingTitle || !readingNote) return;

      readingTitle.textContent = `${button.dataset.arcanaValue} · ${title}`;
      readingNote.textContent = note;
      matrixButtons.forEach((point) => {
        const selected = point === button;
        point.classList.toggle('is-selected', selected);
        point.setAttribute('aria-pressed', String(selected));
      });
    };

    button.addEventListener('pointerenter', showReading);
    button.addEventListener('focus', showReading);
    button.addEventListener('click', showReading);
  }
</script>

<style>
  .personal-details {
    --personal-border: var(--color-border);
    --personal-surface: var(--color-surface);
    --personal-raised: var(--color-surface-elevated);
    --personal-accent: var(--color-accent);
    --personal-accent-light: var(--color-accent-hover);
  }

  .personal-details > h2 { margin-top: clamp(52px, 8vw, 88px); }
  .personal-intro { max-width: 44em; margin-bottom: 24px; }

  .personal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 16px;
  }

  .personal-details--blood-first .blood-card { order: 0; }
  .personal-details--blood-first .personality-card { order: 1; }
  .personal-details--blood-first .matrix-card { order: 2; }
  .personal-details--blood-first .birth-card { order: 3; }
  .personal-details--blood-first .natal-card { order: 4; }
  .personal-details:not(.personal-details--blood-first) .birth-card { order: 0; }
  .personal-details:not(.personal-details--blood-first) .personality-card { order: 1; }
  .personal-details:not(.personal-details--blood-first) .matrix-card { order: 2; }
  .personal-details:not(.personal-details--blood-first) .blood-card { order: 3; }
  .personal-details:not(.personal-details--blood-first) .natal-card { order: 4; }

  .personal-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--personal-border);
    border-radius: 12px;
    background: radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--personal-accent) 9%, transparent), transparent 65%), var(--personal-surface);
    transition: border-color 220ms var(--ease), background-color 220ms var(--ease), transform 220ms var(--ease);
  }

  .personal-card:hover,
  .personal-card:focus-within {
    border-color: color-mix(in srgb, var(--personal-accent) 65%, var(--personal-border));
    background-color: var(--personal-raised);
    transform: translateY(-2px);
  }

  .personal-card > summary {
    position: relative;
    display: flex;
    min-height: 180px;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(18px, 3vw, 28px);
    cursor: pointer;
    list-style: none;
  }

  .personal-card > summary::-webkit-details-marker { display: none; }
  .personal-card > summary:focus-visible { outline: 2px solid var(--personal-accent-light); outline-offset: -4px; border-radius: 12px; }
  .card-kicker, .reading-label { color: var(--color-text-secondary); font-size: 0.67rem; font-weight: 600; letter-spacing: 0.13em; }
  .card-title { margin-top: auto; color: var(--color-text-primary); font-size: clamp(1.3rem, 1.08rem + 0.8vw, 1.8rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.15; }
  .card-action { display: flex; width: 100%; justify-content: space-between; margin-top: 14px; color: var(--personal-accent-light); font-size: 0.84rem; }
  .card-action span { transition: transform 220ms var(--ease); }
  .personal-card:hover .card-action span, .personal-card:focus-within .card-action span { transform: translate(3px, -3px); }

  .birth-card > summary { min-height: 150px; }
  .birth-date { margin-top: auto; color: var(--color-text-primary); font-size: clamp(1.05rem, 1vw + 0.82rem, 1.35rem); font-weight: 500; font-variant-numeric: tabular-nums; line-height: 1.3; }
  .blood-visual { position: relative; display: flex; min-height: 78px; align-items: baseline; gap: 8px; margin-block: 10px; color: var(--personal-accent-light); }
  .blood-visual > span { font-size: 3rem; font-weight: 600; line-height: 1; letter-spacing: -0.08em; }
  .blood-visual > i { color: var(--color-text-secondary); font-size: 0.82rem; font-style: normal; }
  .blood-visual > b { margin-left: auto; font-size: 0.8rem; font-weight: 600; }
  .blood-visual svg { position: absolute; right: 0; bottom: 0; width: 110px; fill: none; stroke: var(--personal-accent); stroke-width: 0.8; opacity: 0.24; }

  .personality-visual {
    display: grid;
    width: 100%;
    min-height: 95px;
    flex: 1;
    grid-template-columns: 1fr;
    align-content: center;
    justify-items: center;
    margin-block: 8px;
    overflow: hidden;
    border-block: 1px solid color-mix(in srgb, var(--personal-accent) 20%, transparent);
    background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.025), transparent);
    color: var(--personal-accent-light);
  }
  .personality-monogram { z-index: 1; font-size: clamp(2.1rem, 4vw, 3rem); font-weight: 700; letter-spacing: 0.16em; line-height: 1; }
  .personality-visual svg { width: min(100%, 280px); height: 55px; overflow: visible; }
  .personality-axis, .personality-bracket { fill: none; stroke: var(--personal-border); stroke-width: 1; }
  .personality-path { fill: none; stroke: var(--personal-accent-light); stroke-dasharray: 1; stroke-dashoffset: 1; stroke-width: 1.5; }
  .personality-node { fill: var(--personal-surface); stroke: var(--personal-accent); stroke-width: 1.5; }
  .personality-node--last { fill: var(--personal-accent-light); }
  .personality-name { color: var(--color-text-secondary); font-size: 0.78rem; }
  .personality-card:hover .personality-path, .personality-card:focus-within .personality-path { stroke-dashoffset: 0; transition: stroke-dashoffset 900ms var(--ease); }

  .matrix-card { grid-row: span 3; padding: clamp(18px, 3vw, 28px); }
  .matrix-card h3 { margin: 6px 0; font-size: clamp(1.3rem, 1.08rem + 0.8vw, 1.8rem); line-height: 1.15; }
  .card-subtitle { color: var(--color-text-secondary); font-size: 0.8rem; line-height: 1.5; }
  .matrix-canvas { position: relative; width: min(100%, 470px); aspect-ratio: 1; margin: 18px auto 10px; }
  .matrix-lines { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: color-mix(in srgb, var(--personal-accent) 48%, var(--personal-border)); stroke-width: 0.36; vector-effect: non-scaling-stroke; }
  .matrix-lines .matrix-cross { stroke: color-mix(in srgb, var(--personal-accent) 26%, var(--personal-border)); stroke-dasharray: 1 1; }
  .matrix-lines .matrix-inner { stroke: color-mix(in srgb, var(--personal-accent) 52%, var(--personal-border)); stroke-dasharray: 1.5 1; }
  .matrix-lines circle { stroke-dasharray: 1 2; opacity: 0.4; }

  .matrix-point {
    position: absolute;
    z-index: 1;
    top: var(--point-y);
    left: var(--point-x);
    display: grid;
    width: clamp(32px, 8.5vw, 46px);
    aspect-ratio: 1;
    place-items: center;
    padding: 0;
    border: 1px solid var(--point-color);
    border-radius: 50%;
    background: var(--personal-surface);
    color: var(--point-color);
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    transform: translate(-50%, -50%);
    transition: background-color 180ms var(--ease), border-color 180ms var(--ease), box-shadow 180ms var(--ease), color 180ms var(--ease), scale 180ms var(--ease);
  }
  .matrix-point--primary { --point-color: #a5c4ff; width: clamp(42px, 10vw, 58px); background: color-mix(in srgb, #31589a 24%, var(--personal-surface)); font-size: 0.9rem; font-weight: 700; }
  .matrix-point--derived { --point-color: #83cfc4; width: clamp(36px, 8vw, 48px); background: color-mix(in srgb, #16766d 15%, var(--personal-surface)); }
  .matrix-point--supporting { --point-color: #c3a6ef; width: clamp(30px, 6.8vw, 39px); background: color-mix(in srgb, #694598 15%, var(--personal-surface)); font-size: 0.68rem; }
  .matrix-point--center { --point-color: #f2c879; width: clamp(48px, 11vw, 64px); background: color-mix(in srgb, #8b5d13 22%, var(--personal-surface)); font-size: 1rem; font-weight: 700; }
  .matrix-point:hover, .matrix-point:focus-visible, .matrix-point.is-selected { z-index: 2; background: var(--point-color); color: #08090b; box-shadow: 0 0 22px color-mix(in srgb, var(--point-color) 45%, transparent); scale: 1.1; }
  .matrix-point:focus-visible { outline: 2px solid var(--personal-accent-light); outline-offset: 3px; }
  .matrix-legend { display: flex; flex-wrap: wrap; gap: 7px 14px; margin: 0 0 14px; color: var(--color-text-secondary); font-size: 0.66rem; }
  .matrix-legend span { display: inline-flex; align-items: center; gap: 5px; }
  .matrix-legend span::before { width: 7px; height: 7px; border-radius: 50%; background: var(--legend-color); content: ''; }
  .legend-primary { --legend-color: #a5c4ff; }
  .legend-derived { --legend-color: #83cfc4; }
  .legend-supporting { --legend-color: #c3a6ef; }
  .matrix-reading { min-height: 90px; padding: 12px 14px; border-left: 2px solid var(--personal-accent); background: color-mix(in srgb, var(--personal-accent) 6%, transparent); }
  .reading-label { display: block; font-size: 0.57rem; }
  .reading-title { display: block; margin-top: 4px; color: var(--color-text-primary); font-size: 0.95rem; }
  .reading-note { margin-top: 4px; color: var(--color-text-secondary); font-size: 0.78rem; line-height: 1.45; }
  .matrix-footnote, .personal-disclaimer { margin-top: 14px; color: var(--color-text-secondary); font-size: 0.7rem; line-height: 1.55; }

  .natal-visual { position: relative; display: grid; width: 100%; flex: 1; min-height: 80px; place-items: center; margin-block: 8px; overflow: hidden; border-block: 1px solid color-mix(in srgb, var(--personal-accent) 18%, transparent); color: var(--personal-accent-light); }
  .natal-visual svg { position: absolute; width: min(55%, 120px); height: auto; }
  .natal-visual > span { z-index: 1; font-size: 1.2rem; }
  .natal-orbit { fill: none; stroke: color-mix(in srgb, var(--personal-accent) 70%, var(--personal-border)); stroke-dasharray: 2 4; stroke-width: 0.8; }
