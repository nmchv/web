const { lang } = Astro.props;
const birthDate = new Date(Date.UTC(2004, 2, 28, 2, 30));
const julianDate = birthDate.getTime() / 86400000 + 2440587.5;
const centuries = (julianDate - 2451545) / 36525;
const radians = (degrees: number) => degrees * Math.PI / 180;
const degrees = (value: number) => ((value % 360) + 360) % 360;
const solveKepler = (meanAnomaly: number, eccentricity: number) => {
  let eccentricAnomaly = meanAnomaly;
  for (let iteration = 0; iteration < 8; iteration += 1) {
    eccentricAnomaly -= (eccentricAnomaly - eccentricity * Math.sin(eccentricAnomaly) - meanAnomaly)
      / (1 - eccentricity * Math.cos(eccentricAnomaly));
  }
  return eccentricAnomaly;
};
const orbitalElements = [
  { name: '☉', a: 1, da: 0.00000000562, e: 0.016708634, de: -0.000042037, i: -0.00001531, di: -0.01294668, l: 100.46457166, dl: 35999.37244981, p: 102.93768193, dp: 0.32327364, n: 0, dn: 0 },
  { name: '☿', a: 0.38709927, da: 0.00000037, e: 0.20563593, de: 0.00001906, i: 7.00497902, di: -0.00594749, l: 252.25032350, dl: 149472.67411175, p: 77.45779628, dp: 0.16047689, n: 48.33076593, dn: -0.12534081 },
  { name: '♀', a: 0.72333566, da: 0.00000390, e: 0.00677672, de: -0.00004107, i: 3.39467605, di: -0.00078890, l: 181.97909950, dl: 58517.81538729, p: 131.60246718, dp: 0.00268329, n: 76.67984255, dn: -0.27769418 },
  { name: '♂', a: 1.52371034, da: 0.00001847, e: 0.09339410, de: 0.00007882, i: 1.84969142, di: -0.00813131, l: -4.55343205, dl: 19140.30268499, p: -23.94362959, dp: 0.44441088, n: 49.55953891, dn: -0.29257343 },
  { name: '♃', a: 5.20288700, da: -0.00011607, e: 0.04838624, de: -0.00013253, i: 1.30439695, di: -0.00183714, l: 34.39644051, dl: 3034.74612775, p: 14.72847983, dp: 0.21252668, n: 100.47390909, dn: 0.20469106 },
  { name: '♄', a: 9.53667594, da: -0.00125060, e: 0.05386179, de: -0.00050991, i: 2.48599187, di: 0.00193609, l: 49.95424423, dl: 1222.49362201, p: 92.59887831, dp: -0.41897216, n: 113.66242448, dn: -0.28867794 },
  { name: '♅', a: 19.18916464, da: -0.00196176, e: 0.04725744, de: -0.00004397, i: 0.77263783, di: -0.00242939, l: 313.23810451, dl: 428.48202785, p: 170.95427630, dp: 0.40805281, n: 74.01692503, dn: 0.04240589 },
  { name: '♆', a: 30.06992276, da: 0.00026291, e: 0.00859048, de: 0.00005105, i: 1.77004347, di: 0.00035372, l: -55.12002969, dl: 218.45945325, p: 44.96476227, dp: -0.32241464, n: 131.78422574, dn: -0.00508664 },
  { name: '♇', a: 39.48211675, da: -0.00031596, e: 0.24882730, de: 0.00005170, i: 17.14001206, di: 0.00004818, l: 238.92903833, dl: 145.20780515, p: 224.06891629, dp: -0.04062942, n: 110.30393684, dn: -0.01183482 },
];
const heliocentricPosition = (element: typeof orbitalElements[number], t: number) => {
  const a = element.a + element.da * t;
  const eccentricity = element.e + element.de * t;
  const inclination = radians(element.i + element.di * t);
  const node = radians(element.n + element.dn * t);
  const perihelion = radians(element.p + element.dp * t);
  const meanAnomaly = radians(degrees(element.l + element.dl * t - element.p - element.dp * t));
  const eccentricAnomaly = solveKepler(meanAnomaly, eccentricity);
  const x = a * (Math.cos(eccentricAnomaly) - eccentricity);
  const y = a * Math.sqrt(1 - eccentricity ** 2) * Math.sin(eccentricAnomaly);
  const trueAnomaly = Math.atan2(y, x);
  const radius = Math.hypot(x, y);
  const argument = trueAnomaly + perihelion - node;
  return [
    radius * (Math.cos(node) * Math.cos(argument) - Math.sin(node) * Math.sin(argument) * Math.cos(inclination)),
    radius * (Math.sin(node) * Math.cos(argument) + Math.cos(node) * Math.sin(argument) * Math.cos(inclination)),
    radius * Math.sin(argument) * Math.sin(inclination),
  ];
};
const earth = heliocentricPosition(orbitalElements[0], centuries);
const meanLongitudeMoon = 218.3164477 + 481267.88123421 * centuries;
const elongation = radians(297.8501921 + 445267.1114034 * centuries);
const sunAnomaly = radians(357.5291092 + 35999.0502909 * centuries);
const moonAnomaly = radians(134.9633964 + 477198.8675055 * centuries);
const moonLatitude = radians(93.2720950 + 483202.0175233 * centuries);
const moonLongitude = degrees(meanLongitudeMoon
  + 6.289 * Math.sin(moonAnomaly)
  + 1.274 * Math.sin(2 * elongation - moonAnomaly)
  + 0.658 * Math.sin(2 * elongation)
  + 0.214 * Math.sin(2 * moonAnomaly)
  - 0.186 * Math.sin(sunAnomaly)
  - 0.114 * Math.sin(2 * moonLatitude)
  + 0.059 * Math.sin(2 * elongation - 2 * moonAnomaly)
  + 0.057 * Math.sin(2 * elongation - sunAnomaly - moonAnomaly)
  + 0.053 * Math.sin(2 * elongation + moonAnomaly)
  + 0.046 * Math.sin(2 * elongation - sunAnomaly)
  + 0.041 * Math.sin(moonAnomaly - sunAnomaly)
  - 0.035 * Math.sin(elongation)
  - 0.031 * Math.sin(moonAnomaly + sunAnomaly)
  - 0.015 * Math.sin(2 * moonLatitude - 2 * elongation)
  + 0.011 * Math.sin(moonAnomaly - 4 * elongation));
const planets = orbitalElements.slice(1).map((element) => {
  const position = heliocentricPosition(element, centuries);
  const longitude = degrees(Math.atan2(position[1] - earth[1], position[0] - earth[0]) * 180 / Math.PI);
  return { name: element.name, longitude };
});
const moon = { name: '☽', longitude: moonLongitude };
const sun = { name: '☉', longitude: degrees(Math.atan2(-earth[1], -earth[0]) * 180 / Math.PI) };
const siderealDegrees = degrees(280.46061837
  + 360.98564736629 * (julianDate - 2451545)
  + 0.000387933 * centuries ** 2
  - centuries ** 3 / 38710000
  + 40.8);
const latitude = radians(48.18);
const obliquity = radians(23.4393 - 0.013 * centuries);
const ascendant = degrees(Math.atan2(
  Math.cos(radians(siderealDegrees)),
  -(Math.sin(obliquity) * Math.tan(latitude) + Math.cos(obliquity) * Math.sin(radians(siderealDegrees))),
) * 180 / Math.PI);
const midheaven = degrees(Math.atan2(
  Math.sin(radians(siderealDegrees)),
  Math.cos(radians(siderealDegrees)) * Math.cos(obliquity),
) * 180 / Math.PI);
const natalPoints = [
  { ...moon, name: '☽' },
  sun,
  ...planets,
].map((planet, index) => {
  const angle = radians(planet.longitude - ascendant + 180);
  const radius = 35 - index % 3 * 5;
  return {
    ...planet,
    sign: Math.floor(planet.longitude / 30),
    degree: Math.floor(planet.longitude % 30),
    x: 50 + Math.cos(angle) * radius,
    y: 50 + Math.sin(angle) * radius,
  };
});
const zodiacSymbols = ['♈︎', '♉︎', '♊︎', '♋︎', '♌︎', '♍︎', '♎︎', '♏︎', '♐︎', '♑︎', '♒︎', '♓︎'];
const zodiacLabels = zodiacSymbols.map((symbol, index) => {
  const angle = radians(index * 30 + 15 - ascendant + 180);
  return { symbol, x: 50 + Math.cos(angle) * 43, y: 50 + Math.sin(angle) * 43 };
});
const houseAngles = Array.from({ length: 12 }, (_, index) => {
  const angle = radians(index * 30 + 180);
  return {
    x: 50 + Math.cos(angle) * 39,
    y: 50 + Math.sin(angle) * 39,
    innerX: 50 + Math.cos(angle) * 10,
    innerY: 50 + Math.sin(angle) * 10,
  };
});

