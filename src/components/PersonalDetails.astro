const formattedBirthday = new Intl.DateTimeFormat(lang, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(birthDate);

const reduceArcana = (value: number): number => {
  let reduced = value;
  while (reduced > 22) {
    reduced = String(reduced).split('').reduce((sum, digit) => sum + Number(digit), 0);
  }
  return reduced;
};

const day = reduceArcana(28);
const month = 3;
const year = reduceArcana(2 + 0 + 0 + 4);
const base = reduceArcana(day + month + year);
const center = reduceArcana(day + month + year + base);
const arcanaNames: Record<string, Record<number, string>> = {
  ru: { 1: 'Маг', 3: 'Императрица', 5: 'Иерофант', 6: 'Влюблённые', 7: 'Колесница', 8: 'Справедливость', 9: 'Отшельник', 10: 'Колесо Фортуны', 11: 'Сила', 12: 'Повешенный', 13: 'Трансформация', 15: 'Дьявол', 16: 'Башня', 19: 'Солнце', 21: 'Мир', 22: 'Шут' },
  en: { 1: 'The Magician', 3: 'The Empress', 5: 'The Hierophant', 6: 'The Lovers', 7: 'The Chariot', 8: 'Justice', 9: 'The Hermit', 10: 'Wheel of Fortune', 11: 'Strength', 12: 'The Hanged One', 13: 'Transformation', 15: 'The Devil', 16: 'The Tower', 19: 'The Sun', 21: 'The World', 22: 'The Fool' },
  fr: { 1: 'Le Magicien', 3: 'L’Impératrice', 5: 'Le Pape', 6: 'Les Amoureux', 7: 'Le Chariot', 8: 'La Justice', 9: 'L’Ermite', 10: 'La Roue de Fortune', 11: 'La Force', 12: 'Le Pendu', 13: 'Transformation', 15: 'Le Diable', 16: 'La Maison Dieu', 19: 'Le Soleil', 21: 'Le Monde', 22: 'Le Mat' },
  es: { 1: 'El Mago', 3: 'La Emperatriz', 5: 'El Hierofante', 6: 'Los Enamorados', 7: 'El Carro', 8: 'La Justicia', 9: 'El Ermitaño', 10: 'La Rueda de la Fortuna', 11: 'La Fuerza', 12: 'El Colgado', 13: 'Transformación', 15: 'El Diablo', 16: 'La Torre', 19: 'El Sol', 21: 'El Mundo', 22: 'El Loco' },
  ko: { 1: '마법사', 3: '여황제', 5: '교황', 6: '연인', 7: '전차', 8: '정의', 9: '은둔자', 10: '운명의 수레바퀴', 11: '힘', 12: '매달린 사람', 13: '변화', 15: '악마', 16: '탑', 19: '태양', 21: '세계', 22: '광대' },
  zh: { 1: '魔术师', 3: '皇后', 5: '教皇', 6: '恋人', 7: '战车', 8: '正义', 9: '隐者', 10: '命运之轮', 11: '力量', 12: '倒吊人', 13: '转变', 15: '恶魔', 16: '高塔', 19: '太阳', 21: '世界', 22: '愚者' },
  ja: { 1: '魔術師', 3: '女帝', 5: '教皇', 6: '恋人', 7: '戦車', 8: '正義', 9: '隠者', 10: '運命の輪', 11: '力', 12: '吊るされた男', 13: '変容', 15: '悪魔', 16: '塔', 19: '太陽', 21: '世界', 22: '愚者' },
  de: { 1: 'Der Magier', 3: 'Die Herrscherin', 5: 'Der Hierophant', 6: 'Die Liebenden', 7: 'Der Wagen', 8: 'Die Gerechtigkeit', 9: 'Der Eremit', 10: 'Das Rad des Schicksals', 11: 'Die Kraft', 12: 'Der Gehängte', 13: 'Wandlung', 15: 'Der Teufel', 16: 'Der Turm', 19: 'Die Sonne', 21: 'Die Welt', 22: 'Der Narr' },
  sv: { 1: 'Magikern', 3: 'Kejsarinnan', 5: 'Hierofanten', 6: 'De älskande', 7: 'Vagnen', 8: 'Rättvisan', 9: 'Eremiten', 10: 'Lyckohjulet', 11: 'Styrkan', 12: 'Den hängde', 13: 'Förvandling', 15: 'Djävulen', 16: 'Tornet', 19: 'Solen', 21: 'Världen', 22: 'Narren' },
};
const names = arcanaNames[lang] ?? arcanaNames.en;
const arcanaTitle = (value: number) => names[value] ?? `${value} · ${lang === 'ru' ? 'аркан' : 'Arcana'}`;
type PointRole = 'primary' | 'derived' | 'supporting' | 'center';
const points: Array<{ id: string; value: number; title: string; role: PointRole; x: number; y: number; detail: string }> = [
  { id: 'day', value: day, title: arcanaTitle(day), role: 'primary', x: 15, y: 50, detail: describeArcana(day) },
  { id: 'month', value: month, title: arcanaTitle(month), role: 'primary', x: 50, y: 9, detail: describeArcana(month) },
  { id: 'year', value: year, title: arcanaTitle(year), role: 'primary', x: 85, y: 50, detail: describeArcana(year) },
  { id: 'base', value: base, title: arcanaTitle(base), role: 'primary', x: 50, y: 91, detail: describeArcana(base) },
  { id: 'day-month', value: reduceArcana(day + month), title: arcanaTitle(reduceArcana(day + month)), role: 'derived', x: 32.5, y: 29.5, detail: describeArcana(reduceArcana(day + month)) },
  { id: 'month-year', value: reduceArcana(month + year), title: arcanaTitle(reduceArcana(month + year)), role: 'derived', x: 67.5, y: 29.5, detail: describeArcana(reduceArcana(month + year)) },
  { id: 'year-base', value: reduceArcana(year + base), title: arcanaTitle(reduceArcana(year + base)), role: 'derived', x: 67.5, y: 70.5, detail: describeArcana(reduceArcana(year + base)) },
  { id: 'base-day', value: reduceArcana(base + day), title: arcanaTitle(reduceArcana(base + day)), role: 'derived', x: 32.5, y: 70.5, detail: describeArcana(reduceArcana(base + day)) },
  { id: 'center', value: center, title: arcanaTitle(center), role: 'center', x: 50, y: 50, detail: describeArcana(center) },
  { id: 'day-inner', value: reduceArcana(day + reduceArcana(day + month)), title: arcanaTitle(reduceArcana(day + reduceArcana(day + month))), role: 'supporting', x: 23.75, y: 15, detail: describeArcana(reduceArcana(day + reduceArcana(day + month))) },
  { id: 'month-inner', value: reduceArcana(month + reduceArcana(day + month)), title: arcanaTitle(reduceArcana(month + reduceArcana(day + month))), role: 'supporting', x: 41.25, y: 15, detail: describeArcana(reduceArcana(month + reduceArcana(day + month))) },
  { id: 'month-inner-right', value: reduceArcana(month + reduceArcana(month + year)), title: arcanaTitle(reduceArcana(month + reduceArcana(month + year))), role: 'supporting', x: 58.75, y: 15, detail: describeArcana(reduceArcana(month + reduceArcana(month + year))) },
  { id: 'year-inner', value: reduceArcana(year + reduceArcana(month + year)), title: arcanaTitle(reduceArcana(year + reduceArcana(month + year))), role: 'supporting', x: 76.25, y: 15, detail: describeArcana(reduceArcana(year + reduceArcana(month + year))) },
  { id: 'year-inner-bottom', value: reduceArcana(year + reduceArcana(year + base)), title: arcanaTitle(reduceArcana(year + reduceArcana(year + base))), role: 'supporting', x: 76.25, y: 85, detail: describeArcana(reduceArcana(year + reduceArcana(year + base))) },
  { id: 'base-inner-right', value: reduceArcana(base + reduceArcana(year + base)), title: arcanaTitle(reduceArcana(base + reduceArcana(year + base))), role: 'supporting', x: 58.75, y: 85, detail: describeArcana(reduceArcana(base + reduceArcana(year + base))) },
  { id: 'base-inner-left', value: reduceArcana(base + reduceArcana(base + day)), title: arcanaTitle(reduceArcana(base + reduceArcana(base + day))), role: 'supporting', x: 41.25, y: 85, detail: describeArcana(reduceArcana(base + reduceArcana(base + day))) },
  { id: 'day-inner-bottom', value: reduceArcana(day + reduceArcana(base + day)), title: arcanaTitle(reduceArcana(day + reduceArcana(base + day))), role: 'supporting', x: 23.75, y: 85, detail: describeArcana(reduceArcana(day + reduceArcana(base + day))) },
];
const roleLabels: Record<PointRole, string> = {
  primary: copy.primary,
  derived: copy.derived,
  supporting: copy.supporting,
  center: copy.center,
};
---

<section class="personal-details" aria-labelledby="personal-details-heading">
  <h2 id="personal-details-heading">{copy.heading}</h2>
  <p class="personal-intro">{copy.intro}</p>

  <div class="personal-grid">
    <details class="personal-card birth-card">
      <summary>
        <span class="card-kicker">{copy.birthday}</span>
        <time class="birth-date" datetime="2004-03-28">{formattedBirthday}</time>
        <span class="birthday-prompt">{birthdayPrompts[lang] ?? birthdayPrompts.en}</span>
      </summary>
      <div class="card-detail">
        <div class="card-detail-inner">
          <p>{birthdayPrompts[lang] ?? birthdayPrompts.en}</p>
          <p>{birthdayCelebrities}</p>
        </div>
      </div>
    </details>

    <details class="personal-card blood-card">
      <summary>
        <span class="card-kicker">{copy.blood}</span>
        <span class="blood-visual" aria-hidden="true"><span>A</span><i>II</i><b>Rh+</b><svg viewBox="0 0 160 100"><path d="M80 8 142 42v18l-62 34L18 60V42zM18 42l62 36 62-36M80 78v16" /></svg></span>
        <span class="card-title">{copy.bloodType}</span>
      </summary>
      <div class="card-detail"><div class="card-detail-inner"><p>{copy.bloodDetail}</p></div></div>
    </details>

    <details class="personal-card personality-card">
      <summary>
        <span class="card-kicker">{copy.type}</span>
        <span class="personality-visual" aria-hidden="true">
          <span class="personality-monogram">INTJ</span>
          <svg viewBox="0 0 240 140">
            <path class="personality-axis" d="M24 110h192M45 91 93 57l40 16 65-50" />
            <path class="personality-path" d="M45 91 93 57l40 16 65-50" />
            <circle class="personality-node" cx="45" cy="91" r="6" />
            <circle class="personality-node" cx="93" cy="57" r="6" />
            <circle class="personality-node" cx="133" cy="73" r="6" />
            <circle class="personality-node personality-node--last" cx="198" cy="23" r="8" />
            <path class="personality-bracket" d="M45 100v7h153v-7" />
          </svg>
          <span class="personality-name">{copy.strategist}</span>
        </span>
      </summary>
      <div class="card-detail">
        <div class="card-detail-inner">
          <p>{copy.typeDetail}</p>
          <a class="personality-link" href="https://www.16personalities.com/intj-personality" target="_blank" rel="noopener noreferrer">16Personalities · INTJ</a>
        </div>
      </div>
    </details>

    <section class="personal-card matrix-card" aria-labelledby="matrix-title">
      <div class="card-kicker">{copy.matrixKicker}</div>
      <h3 id="matrix-title">{copy.matrix}</h3>
      <p class="matrix-personal-reading">{copy.matrixReading}</p>
      <p class="card-subtitle">{copy.matrixHint}</p>
      <div class="matrix-canvas" role="group" aria-label={copy.matrix}>
        <svg class="matrix-lines" viewBox="0 0 100 100" aria-hidden="true">
          <path class="matrix-diamond" d="M50 9 85 50 50 91 15 50 50 9" />
          <path class="matrix-cross" d="M50 9v82M15 50h70M32.5 29.5 67.5 70.5M67.5 29.5 32.5 70.5" />
          <path class="matrix-inner" d="M23.75 15 76.25 15 85 50 76.25 85 23.75 85 15 50Z" />
          <circle cx="50" cy="50" r="23" />
        </svg>
        {points.map((point, index) => (
          <button
            class:list={['matrix-point', `matrix-point--${point.role}`, index === 0 && 'is-selected']}
            type="button"
            style={`--point-x:${point.x}%;--point-y:${point.y}%`}
            data-arcana-id={point.id}
            data-arcana-title={point.title}
            data-arcana-note={point.detail}
            data-arcana-value={point.value}
            aria-label={`${roleLabels[point.role]} ${point.value}: ${point.title}`}
            aria-pressed={index === 0 ? 'true' : 'false'}
            title={`${point.value} · ${point.title}`}
          >
            <span>{point.value}</span>
          </button>
        ))}
      </div>
      <div class="matrix-legend" aria-label={copy.matrix}>
        <span class="legend-primary">{copy.primary}</span>
        <span class="legend-derived">{copy.derived}</span>
        <span class="legend-supporting">{copy.supporting}</span>
      </div>
      <div class="matrix-reading" aria-live="polite" aria-atomic="true">
        <span class="reading-label">{copy.selected}</span>
        <strong class="reading-title">{arcanaTitle(day)}</strong>
        <p class="reading-note">{points[0].detail}</p>
      </div>
    </section>

    <section class="personal-card natal-card" aria-labelledby="natal-title">
      <div class="natal-card-heading">
        <div>
          <span class="card-kicker">{copy.astrology}</span>
          <h3 id="natal-title">{copy.natal}</h3>
        </div>
        <span class="natal-location">{copy.chartLocation}</span>
      </div>
      <div class="natal-chart">
        <svg viewBox="0 0 600 600" aria-hidden="true">
          <circle class="natal-zodiac-ring" cx="300" cy="300" r="276" />
          <circle class="natal-zodiac-inner" cx="300" cy="300" r="228" />
          <circle class="natal-house-ring" cx="300" cy="300" r="218" />
          <circle class="natal-inner-ring" cx="300" cy="300" r="142" />
          {Array.from({ length: 12 }, (_, index) => {
            const angle = radians(index * 30 + 270);
            const inner = index % 3 === 0 ? 228 : 239;
            return <line class="natal-zodiac-divider" x1={300 + Math.cos(angle) * inner} y1={300 + Math.sin(angle) * inner} x2={300 + Math.cos(angle) * 276} y2={300 + Math.sin(angle) * 276} />;
          })}
          {houseAngles.map((house) => <line class="natal-house-line" x1={300 + (house.innerX - 50) * 6} y1={300 + (house.innerY - 50) * 6} x2={300 + (house.x - 50) * 6} y2={300 + (house.y - 50) * 6} />)}
          <line class="natal-angle-line" x1="300" y1="300" x2={300 + Math.cos(radians(180)) * 218} y2={300 + Math.sin(radians(180)) * 218} />
          <line class="natal-midheaven-line" x1="300" y1="300" x2={300 + Math.cos(radians(midheaven - ascendant + 180)) * 218} y2={300 + Math.sin(radians(midheaven - ascendant + 180)) * 218} />
          <circle class="natal-center" cx="300" cy="300" r="4" />
        </svg>
        {zodiacLabels.map((label) => <span class="natal-zodiac-symbol" style={`--x:${label.x}%;--y:${label.y}%`}>{label.symbol}</span>)}
        {houseAngles.map((_, index) => (
          <span class="natal-house-number" style={`--x:${50 + Math.cos(radians(index * 30 + 285)) * 25}%;--y:${50 + Math.sin(radians(index * 30 + 285)) * 25}%`}>{index + 1}</span>
        ))}
        {natalPoints.map((point) => (
          <button
            class="natal-planet"
            type="button"
            style={`--x:${point.x}%;--y:${point.y}%`}
            aria-label={`${point.name} ${point.degree}° ${zodiacSymbols[point.sign]}`}
            data-natal-note={planetNotes[lang]?.[point.name] ?? planetNotes.en[point.name]}
          >
            <span>{point.name}</span><small>{point.degree}°</small>
          </button>
        ))}
        <span class="natal-angle natal-angle--asc" style={`--x:${50 + Math.cos(radians(180)) * 46}%;--y:${50 + Math.sin(radians(180)) * 46}%`}>ASC</span>
        <span class="natal-angle natal-angle--mc" style={`--x:${50 + Math.cos(radians(midheaven - ascendant + 180)) * 46}%;--y:${50 + Math.sin(radians(midheaven - ascendant + 180)) * 46}%`}>MC</span>
      </div>
      <p class="natal-reading" aria-live="polite" aria-atomic="true">{chartInsights[lang] ?? chartInsights.en}</p>
      <p class="personal-disclaimer">{copy.chartDisclaimer}</p>
    </section>
  </div>

</section>

<script>
  const matrixButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.matrix-point'));
  const matrixReading = document.querySelector<HTMLElement>('.matrix-reading');
  const readingTitle = matrixReading?.querySelector<HTMLElement>('.reading-title');
  const readingNote = matrixReading?.querySelector<HTMLElement>('.reading-note');
  const natalReading = document.querySelector<HTMLElement>('.natal-reading');
  const natalPlanets = Array.from(document.querySelectorAll<HTMLButtonElement>('.natal-planet'));
  const detailCards = Array.from(document.querySelectorAll<HTMLDetailsElement>('.personal-grid > details.personal-card'));
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  for (const card of detailCards) {
    card.addEventListener('pointerenter', () => {
      if (finePointer.matches) card.open = true;
    });
    card.addEventListener('pointerleave', () => {
      if (!card.matches(':focus-within')) card.open = false;
    });
    card.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && card.contains(event.relatedTarget)) return;
      if (!card.matches(':hover')) card.open = false;
    });
  }

  for (const planet of natalPlanets) {
    const showPlanet = () => {
      const note = planet.dataset.natalNote;
      if (note && natalReading) natalReading.textContent = note;
    };
    planet.addEventListener('pointerenter', showPlanet);
    planet.addEventListener('focus', showPlanet);
    planet.addEventListener('click', showPlanet);
  }

  const summaries = Array.from(document.querySelectorAll<HTMLDetailsElement>('.personal-details details.personal-card'));
  for (const card of summaries) {
    card.addEventListener('pointerenter', () => { card.open = true; });
    card.addEventListener('pointerleave', () => {
      if (!card.contains(document.activeElement)) card.open = false;
    });
    card.addEventListener('focusout', (event) => {
      const nextTarget = event.relatedTarget;
      if (!(nextTarget instanceof Node) || !card.contains(nextTarget)) card.open = false;
    });
  }

  for (const button of matrixButtons) {
    const showReading = () => {
      const title = button.dataset.arcanaTitle;
      const note = button.dataset.arcanaNote;
      if (!title || !note || !readingTitle || !readingNote) return;

      readingTitle.textContent = `${button.dataset.arcanaValue} · ${title}`;
      readingNote.textContent = note;
      matrixButtons.forEach((point) => {
        const selected = point === button;
        point.classList.toggle('is-selected', selected);
        point.setAttribute('aria-pressed', String(selected));
      });
    };

    button.addEventListener('pointerenter', showReading);
    button.addEventListener('focus', showReading);
    button.addEventListener('click', showReading);
  }
</script>

<style>
  .personal-details {
    --personal-border: var(--color-border);
    --personal-surface: var(--color-surface);
    --personal-raised: var(--color-surface-elevated);
    --personal-accent: var(--color-accent);
    --personal-accent-light: var(--color-accent-hover);
  }

  .personal-details > h2 { margin-top: clamp(52px, 8vw, 88px); }
  .personal-intro { max-width: 44em; margin-bottom: 24px; }

  .personal-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: stretch;
    gap: 16px;
  }

  .birth-card, .blood-card, .personality-card { grid-column: span 4; }
  .matrix-card { grid-column: 1 / -1; order: 1; }
  .natal-card { grid-column: 1 / -1; order: 2; }

  .personal-card {
    min-width: 0;
    overflow: hidden;
