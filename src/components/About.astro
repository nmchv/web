---
import { content } from '../data';
const { ui, profile, education, directions } = content;
const photo = profile.photo;
---
<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class:list={['about-grid', { 'has-photo': !!photo }]}>
      <div data-reveal>
        <span class="section-index">02</span>
        <h2 id="about-title" style="font-size:var(--fs-h2);font-weight:600;line-height:1.1;letter-spacing:-0.025em">{ui.about.title}</h2>
        <p class="alias">Псевдоним · <b>{profile.alias}</b></p>
      </div>
      {photo && (
        <img class="about-photo" src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" data-reveal />
      )}
      <div class="about-text" data-reveal style="--d:100ms">
        {profile.about.map((t) => <p>{t}</p>)}
      </div>
    </div>

    {education.length > 0 && (
      <div data-reveal>
        <h3 class="visually-hidden">{ui.education.title}</h3>
        <ol class="timeline">
          {education.map((e) => (
            <li>
              <span class="period">{e.period}</span>
              <div>
                <p class="t">{e.title}</p>
                {e.place && <p class="s">{e.place}</p>}
                {e.note && <p class="s">{e.note}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}
  </div>
</section>

<section class="section" id="directions" aria-labelledby="directions-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="section-index">03</span>
      <h2 id="directions-title">{ui.directions.title}</h2>
      <p>{ui.directions.lead}</p>
    </div>
    <ul class="directions" data-reveal>
      {directions.map((d) => <li>{d.title}</li>)}
    </ul>
  </div>
</section>
