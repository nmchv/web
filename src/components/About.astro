---
import type { SiteContent } from '../data';
interface Props { content: SiteContent }
const { ui, profile, directions } = Astro.props.content;
const photo = profile.photo ?? {
  src: '/images/about/portrait.jpg',
  alt: ui.about.photoAlt,
  width: 2000,
  height: 1500,
};
---
<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="about-grid has-photo">
      <div class="about-intro" data-reveal>
        <span class="section-index">02</span>
        <h2 id="about-title" style="font-size:var(--fs-h2);font-weight:600;line-height:1.1;letter-spacing:-0.025em">{ui.about.title}</h2>
        <p class="alias">{ui.aliasLabel} <b>{profile.alias}</b></p>
        <div class="about-text">
          {profile.about.map((t) => <p>{t}</p>)}
        </div>
      </div>
      <img class="about-photo" src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" data-reveal style="--d:120ms" />
    </div>
  </div>
</section>

<section class="section" id="directions" aria-labelledby="directions-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="section-index">03</span>
      <h2 id="directions-title">{ui.directions.title}</h2>
      <p>{ui.directions.lead}</p>
    </div>
    <ul class="directions" data-reveal>
      {directions.map((d, i) => (
        <li data-reveal style={`--d:${i * 100}ms`}>
          <span class="direction-title">{d.title}</span>
          {d.description && <span class="direction-description">{d.description}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>
