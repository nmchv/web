---
import type { SiteContent } from '../data';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProjectArt from './ProjectArt.astro';

interface Props { content: SiteContent }
const { content } = Astro.props;
const { ui, projects } = content;
---
<Base content={content} skipTarget="project-list" pageTitle={`${ui.projectsPage.title} — ${content.profile.name}`}>
  <Header content={content} isProjectsPage />
  <main id="project-list" class="projects-page">
    <div class="container">
      <div class="projects-intro" data-reveal>
        <div class="projects-intro-copy">
          <a class="projects-back" href={`${ui.lang === 'ru' ? '' : `/${ui.lang}`}/`}>{ui.projectsPage.back}</a>
          <span class="section-index">01 — {String(projects.length).padStart(2, '0')}</span>
          <h1>{ui.projectsPage.title}</h1>
          <p>{ui.projectsPage.lead}</p>
        </div>
        <nav class="project-map" aria-label={ui.projectsPage.mapLabel}>
          <svg viewBox="0 0 420 250" aria-hidden="true" focusable="false">
            <circle class="project-map-orbit" cx="210" cy="125" r="78" />
            <circle class="project-map-orbit project-map-orbit--outer" cx="210" cy="125" r="112" />
            <path d="M72 49 210 125 192 22M337 61 210 125 116 128M278 124 210 125 48 210M208 198 210 125 354 196" />
            <circle class="project-map-core" cx="210" cy="125" r="26" />
            <text class="project-map-monogram" x="210" y="130" text-anchor="middle">NM</text>
          </svg>
          {projects.map((project, index) => {
            const positions = [
              { x: 72, y: 49 }, { x: 192, y: 22 }, { x: 337, y: 61 }, { x: 116, y: 128 },
              { x: 278, y: 124 }, { x: 48, y: 210 }, { x: 208, y: 198 }, { x: 354, y: 196 },
            ];
            const { x, y } = positions[index];
            return (
              <a
                class="project-map-node"
                href={`#project-${project.id}`}
                data-project-map-link
                data-project-status={project.status}
                style={`--x:${(x / 420) * 100}%;--y:${(y / 250) * 100}%;--i:${index}`}
                aria-label={`${String(index + 1).padStart(2, '0')}: ${project.title}`}
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
              </a>
            );
          })}
        </nav>
      </div>
      <div class="project-controls" aria-label={ui.projectsPage.mapLabel}>
        <div class="project-filters" role="group" aria-label={ui.projectsPage.filterLabel}>
          <button type="button" class="project-filter" data-project-filter="all" aria-pressed="true">{ui.projectsPage.filterAll} <span>{projects.length}</span></button>
          <button type="button" class="project-filter" data-project-filter="live" aria-pressed="false">{ui.projectsPage.filterLive} <span>{projects.filter((project) => project.status === 'live').length}</span></button>
          <button type="button" class="project-filter" data-project-filter="in-progress" aria-pressed="false">{ui.projectsPage.filterDevelopment} <span>{projects.filter((project) => project.status === 'in-progress').length}</span></button>
        </div>
        <p class="project-result-count" data-project-result-count data-result-label={ui.projectsPage.filterResults} aria-live="polite">{projects.length} — {ui.projectsPage.filterResults}</p>
      </div>
      <ol class="project-list">
        {projects.map((project, index) => (
          <li id={`project-${project.id}`} class="project-row" data-reveal data-project-row data-project-status={project.status} style={`--d:${index * 70}ms`}>
            <span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="project-illustration"><ProjectArt kind={project.art} /></div>
            <div class="project-details">
              <div class="card-meta">
                <span>{project.category}</span>
                <span class="status" data-status={project.status}>{ui.status[project.status]}</span>
              </div>
              <h2>{project.title}</h2>
              <p>{project.description}</p>
              {project.url && (
                <a class="project-service-link" href={project.url} target="_blank" rel="noopener noreferrer">
                  {ui.projectsPage.visit}
                  <span>{new URL(project.url).host}</span>
                  <span class="visually-hidden"> {ui.projectsPage.newTab}</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </main>
  <Footer content={content} isProjectsPage />
  <script>
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-filter]'));
    const projectRows = Array.from(document.querySelectorAll<HTMLElement>('[data-project-row]'));
    const mapLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-project-map-link]'));
    const resultCount = document.querySelector<HTMLElement>('[data-project-result-count]');

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        const filter = button.dataset.projectFilter;
        if (!filter) return;

        let visibleCount = 0;
        for (const row of projectRows) {
          const visible = filter === 'all' || row.dataset.projectStatus === filter;
          row.hidden = !visible;
          if (visible) visibleCount += 1;
        }
        for (const link of mapLinks) {
          link.hidden = filter !== 'all' && link.dataset.projectStatus !== filter;
        }
        for (const item of filterButtons) {
          item.setAttribute('aria-pressed', String(item === button));
        }
        if (resultCount) resultCount.textContent = `${visibleCount} — ${resultCount.dataset.resultLabel ?? ''}`;
      });
    }
  </script>
</Base>
