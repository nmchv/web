---
import HeroArt from './HeroArt.astro';
import type { SiteContent } from '../data';
interface Props { content: SiteContent }
const { ui, profile } = Astro.props.content;
const parts = profile.name.split(' ');
const first = parts.slice(0, 2).join(' ');
const last = parts.slice(2).join(' ');
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div>
      <p class="eyebrow" data-reveal>{ui.heroEyebrow}</p>
      <h1 id="hero-title" data-reveal style="--d:80ms">
        {first}
        {last && <span class="surname">{last}</span>}
      </h1>
      {profile.additionalName && <p class="additional-name" data-reveal style="--d:120ms">{profile.additionalName}</p>}
      <ul class="signature" data-reveal style="--d:160ms" aria-label={ui.signatureLabel}>
        {profile.signature.map((s) => <li>{s}</li>)}
      </ul>
      <p class="lead" data-reveal style="--d:240ms">{profile.lead}</p>
    </div>
    <div data-reveal style="--d:200ms">
      <HeroArt schoolLabel={ui.schoolLabel} schoolCaption={ui.schoolCaption} />
      <p class="coords" aria-hidden="true">N 47°21′ · E 39°75′</p>
    </div>
  </div>
</section>
