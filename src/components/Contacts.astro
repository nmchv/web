---
import type { SiteContent } from '../data';
interface Props { content: SiteContent }
const { ui, contacts } = Astro.props.content;
---
{contacts.length > 0 && (
  <section class="section" id="contacts" aria-labelledby="contacts-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="section-index">04</span>
        <h2 id="contacts-title">{ui.contacts.title}</h2>
        <p>{ui.contacts.lead}</p>
      </div>
      <a class="btn contact-booking" href="https://appointment.nmchv.ru" target="_blank" rel="noopener noreferrer" data-reveal>
        {ui.contacts.bookingCta}
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 13L13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.75" /></svg>
      </a>
      <ul class="contact-list" data-reveal>
        {contacts.map((c, i) => (
          <li data-reveal style={`--d:${i * 70}ms`}>
            <a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <span class="label">{c.label}</span>
              <span>{c.value}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
