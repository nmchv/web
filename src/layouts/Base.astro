---
import '../styles/global.css';
import type { SiteContent } from '../data';
interface Props {
  content: SiteContent;
  skipTarget?: string;
  pageTitle?: string;
}
const { content } = Astro.props;
const { ui } = content;
const { skipTarget = 'projects', pageTitle = ui.siteTitle } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pagePath = Astro.url.pathname
  .replace(/^\/(en|fr|es|ko|zh|ja|de|sv)(?=\/)/, '')
  .replace(/\/+$/, '');
---
<!doctype html>
<html lang={ui.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={ui.siteDescription} />
    <meta name="theme-color" content="#08090B" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={new URL(pagePath || '/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${pagePath || '/'}`, Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL(`/fr${pagePath || '/'}`, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(`/es${pagePath || '/'}`, Astro.site)} />
    <link rel="alternate" hreflang="ko" href={new URL(`/ko${pagePath || '/'}`, Astro.site)} />
    <link rel="alternate" hreflang="zh" href={new URL(`/zh${pagePath || '/'}`, Astro.site)} />
    <link rel="alternate" hreflang="ja" href={new URL(`/ja${pagePath || '/'}`, Astro.site)} />
    <link rel="alternate" hreflang="de" href={new URL(`/de${pagePath || '/'}`, Astro.site)} />
    <link rel="alternate" hreflang="sv" href={new URL(`/sv${pagePath || '/'}`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath || '/', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ui.ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ui.siteDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href={`#${skipTarget}`}>{ui.skipToContent}</a>
    <slot />
    <script>
      // появление блоков при прокрутке
      const reveal = Array.from(document.querySelectorAll<HTMLElement>(
        '[data-reveal], .about-document h2, .about-document > p:not(.about-tagline)',
      ));
      let previousScrollY = window.scrollY;
      let scrollDirection: 'up' | 'down' = 'down';
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            const element = e.target as HTMLElement;
            element.dataset.scrollDirection = scrollDirection;
            element.classList.toggle('is-visible', e.isIntersecting);
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        reveal.forEach((el) => io.observe(el));
      } else {
        reveal.forEach((el) => el.classList.add('is-visible'));
      }

      const photoImages = Array.from(document.querySelectorAll<HTMLImageElement>('.photo-image'));
      for (const image of photoImages) {
        const markLoaded = () => image.closest('.photo-placeholder')?.classList.add('has-photo');
        image.addEventListener('load', markLoaded, { once: true });
        if (image.complete && image.naturalWidth > 0) markLoaded();
      }

      // тонкая граница у шапки после прокрутки
      const header = document.getElementById('site-header');
      const onScroll = () => {
        const currentScrollY = window.scrollY;
        if (currentScrollY !== previousScrollY) {
          scrollDirection = currentScrollY > previousScrollY ? 'down' : 'up';
          previousScrollY = currentScrollY;
        }
        header?.classList.toggle('is-scrolled', currentScrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // подсветка активного пункта меню
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav]'));
      const map = new Map<string, HTMLAnchorElement>(links.map((a) => [a.dataset.nav as string, a]));
      const secs = ['projects', 'about', 'directions', 'contacts']
        .map((id) => document.getElementById(id)).filter((s): s is HTMLElement => !!s);
      if ('IntersectionObserver' in window) {
        const spy = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const key = e.target.id === 'directions' ? 'about' : e.target.id;
            links.forEach((a) => a.removeAttribute('aria-current'));
            map.get(key)?.setAttribute('aria-current', 'true');
          }
        }, { rootMargin: '-40% 0px -55% 0px' });
        secs.forEach((s) => spy.observe(s));
      }
    </script>
  </body>
</html>
